# Kyber PQC KEM Engine - Environment Configuration
# Copy this file to .env and update values for your environment

# Cryptographic secret key for HMAC-SHA256 audit trail signing
# MUST be set to a strong random value in production (min 32 bytes recommended)
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
AUDIT_SECRET_KEY=

# LLM provider for chat/analysis features
# Only mock is implemented; no external inference calls are made
MODEL_PROVIDER=mock

# API server configuration
API_HOST=127.0.0.1
API_PORT=8000
